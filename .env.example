# Base directory where archived sites are stored. Each crawl creates a
# subfolder named after the target host (e.g. ./archive/example.com/...).
OUTPUT_FOLDER=./archive

# User-Agent sent with discovery requests and used for robots.txt matching.
# USER_AGENT=SiteArchiver/1.0 (+https://github.com/your-org/site-archiver)

# Explicit path to the SingleFile CLI executable/script. When unset, a sibling
# checkout at ../single-file-cli is used (git clone
# https://github.com/gildas-lormeau/single-file-cli next to this repo, then run
# `npm install` inside it). SingleFile is no longer an npm dependency here.
# SINGLEFILE_PATH=D:\MCP\single-file-cli\single-file-node.js

# Extra arguments appended to every SingleFile invocation (space separated).
# SINGLEFILE_ARGS=--browser-wait-until=networkIdle

# Path to a Chrome/Chromium/Edge executable for SingleFile to drive. When
# unset, SingleFile auto-detects an installed browser.
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Retry behaviour for discovery requests.
# MAX_RETRIES=3
# RETRY_DELAY_MS=1000
